# BrightRule on ObjectOS EE — environment template.
# Copy to a file outside the repository (never commit filled-in values) and
# pass it with `docker run --env-file`.

# ── Licence and posture ──────────────────────────────────────────────────────
# Composed artifact boot needs an air-gap licence (`offline: true`) and no
# control plane. The image already sets OS_COMPOSED_ARTIFACT_URL and OS_CLOUD_URL=off.
OS_LICENSE_KEY=
# Leave OS_AI_STUDIO_AGENTS unset. `ask` alone puts the deployment in the
# query-only posture, which withholds every business action from the chat,
# including the 转人工 action.
# OS_AI_STUDIO_AGENTS=

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
OS_DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/brightrule
# openssl rand -hex 32, each
OS_AUTH_SECRET=
OS_SECRET_KEY=
# The deployment's public address (approval and invitation links).
# OS_BASE_URL=https://policy.example.com

# ── 制度问询 retrieval (src/qa/vector/env.ts) ─────────────────────────────────
# Unset OS_KNOWLEDGE_EMBEDDING_MODEL = keyword retrieval (demo only).
# DeepSeek has no embedding API: name a separate embedding model here, e.g. a
# local bge-m3 (Ollama / vLLM), DashScope text-embedding-v3, SiliconFlow BAAI/bge-m3.
OS_KNOWLEDGE_VECTOR_STORE=pgvector
OS_KNOWLEDGE_PGVECTOR_URL=postgres://USER:PASSWORD@HOST:5432/brightrule
OS_KNOWLEDGE_EMBEDDING_BASE_URL=
OS_KNOWLEDGE_EMBEDDING_MODEL=
OS_KNOWLEDGE_EMBEDDING_API_KEY=
# Required when the embedder does not know the model's vector size (≤ 2000 for the HNSW index).
OS_KNOWLEDGE_EMBEDDING_DIMENSIONS=

# ── Chat model ───────────────────────────────────────────────────────────────
# Set in the Console, not here: Setup → AI 与向量化 → 提供商 = DeepSeek
# (OpenAI 兼容), API key, model `deepseek-flash`. The key is stored encrypted.
